{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airwallex Open Authentication Balances API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current account balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.airwallex.com/api/v1/balances/current"
          },
          "docs": "Get current account balances"
        }
      ]
    }
  ],
  "bundled": true
}