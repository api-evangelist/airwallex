              ],
              "query": [],
              "variable": []
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "b3eb805d-b1d1-4a11-bd99-21ba142cd760",
              "name": "Access token returned",
              "originalRequest": {
